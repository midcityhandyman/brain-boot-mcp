# brain-boot-mcp configuration. Every value is optional; the defaults run the
# SQLite backend with no keys and no network.
# The server reads real environment variables. It does not load this file by
# itself: export the values, or set them in your MCP host's server config.

# sqlite (default) or postgres
BRAIN_BOOT_BACKEND=sqlite

# SQLite database file (created on first use)
BRAIN_BOOT_DB=brain.db

# Only for BRAIN_BOOT_BACKEND=postgres. Placeholder shown; never commit a real one.
# BRAIN_BOOT_PG_DSN=postgresql://brain_user:change-me@localhost:5432/brain

# What goes into a pack
BRAIN_BOOT_CORRECTION_DAYS=14
BRAIN_BOOT_CORRECTION_LIMIT=10
BRAIN_BOOT_DUE_HOURS=24
BRAIN_BOOT_DUE_LIMIT=20

# Only for running tests/test_postgres.py against a throwaway database
# BRAIN_BOOT_TEST_PG_DSN=postgresql://postgres:test@localhost:54329/postgres
